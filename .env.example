# --- Model access (discovery and chat; replay never needs this) ---
LLM_PROVIDER=openai            # openai | transcript (requires --transcript file)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# --- Target app (the local legacy stand-in) ---
TARGET_APP_PORT=4173
OPERATOR_PORT=4180

# --- Credentials for the target app.
# Loaded into a SecretRef vault at runtime; never written to artifacts or logs.
LEDGERHAND_OPERATOR_USER=svc_agent
LEDGERHAND_OPERATOR_PASS=demo-password-not-real

# --- Meridian Core sandbox (the live host the exercise is graded against) ---
# Override to point discovery and replay somewhere else.
MERIDIAN_BASE_URL=https://web-sample.interface-hiring.com

# Two operator identities, because they are not interchangeable. Placing a hold is
# refused for the teller profile at the *review* step -- after the form is filled --
# with SUPERVISOR OVERRIDE REQUIRED. Everything else works as either.
# Both are the sandbox demo logins, printed on the host's own sign-on page.
LEDGERHAND_SECRET_MERIDIAN_OPERATOR_USER=teller1
LEDGERHAND_SECRET_MERIDIAN_OPERATOR_PASS=password
LEDGERHAND_SECRET_MERIDIAN_SUPERVISOR_USER=super1
LEDGERHAND_SECRET_MERIDIAN_SUPERVISOR_PASS=password

# --- Runtime ---
HEADLESS=false                 # headed by default so operator handoff is demonstrable
