{
  "name": "ledgerhand",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation: an LLM discovers a flow in a legacy UI once, the run is compiled into a typed capability artifact, and that artifact replays deterministically with no model in the loop.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ledgerhand": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "target-app": "tsx target-app/server.ts",
    "operator": "tsx src/escalation/operator-server.ts",
    "cli": "tsx src/cli.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "catalog": "tsx src/cli.ts catalog",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture-evidence": "tsx scripts/capture-evidence.ts",
    "demo:discover": "tsx src/cli.ts discover read-balance",
    "demo:replay": "tsx src/cli.ts replay member.read-savings-balance --input memberId=12345",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "openai": "^4.73.0",
    "playwright": "^1.49.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
