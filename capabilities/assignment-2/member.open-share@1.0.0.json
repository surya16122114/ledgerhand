{
  "description": "Opens a new Money Market share for the specified member with the given initial deposit, posts it, and retrieves the new share ID once the process is complete.\n\nRecorded from the goal: \"Sign on to Meridian Core, look up the member, open a new share of the given type with the given initial deposit, review the confirmation screen, post it, and read the new share id.\"",
  "id": "member.open-share",
  "inputs": [
    {
      "description": "The credit union member number.",
      "name": "memberId",
      "pattern": "^\\d{6}$",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "Share type code. The host offers S0001, S0070, MMKT and CERT.",
      "name": "shareType",
      "pattern": "^(S0001|S0070|MMKT|CERT)$",
      "required": true,
      "sensitivity": "internal",
      "type": "string"
    },
    {
      "description": "Opening deposit in dollars.",
      "name": "initialDeposit",
      "required": true,
      "sensitivity": "internal",
      "type": "money"
    }
  ],
