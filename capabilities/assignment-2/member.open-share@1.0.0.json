      "notDuringAuth": true,
      "then": {
        "do": "reauthenticate",
        "maxAttempts": 1
      },
      "when": {
        "kind": "textPresent",
        "pattern": "YOUR SESSION HAS TIMED OUT|session ended due to inactivity"
      }
    },
    {
      "name": "maintenance-window",
      "notDuringAuth": false,
      "then": {
        "do": "dismiss",
        "target": {
          "description": "Continue link on the maintenance notice",
          "strategies": [
            {
              "kind": "role-name",
              "name": "Continue",
              "nameMatch": "normalized",
              "role": "link"
            }
          ]
        },
        "thenRetryStep": true
      },
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "textPresent",
            "pattern": "SCHEDULED MAINTENANCE IN PROGRESS|This window normally clears within a few moments"
          },
          {
            "kind": "controlPresent",
            "target": {
              "description": "Continue link on the maintenance notice",
              "strategies": [
                {
                  "kind": "role-name",
                  "name": "Continue",
                  "nameMatch": "normalized",
                  "role": "link"
                }
              ]
            }
          }
        ]
      }
    },
