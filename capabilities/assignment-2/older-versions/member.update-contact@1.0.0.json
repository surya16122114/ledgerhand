      "name": "memberId",
      "pattern": "^\\d{6}$",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "New e-mail address for the member.",
      "name": "email",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$",
