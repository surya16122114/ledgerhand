{
  "description": "Posts a funds transfer between the specified member shares, then retrieves and confirms the transaction reference after successful posting.\n\nRecorded from the goal: \"Sign on to Meridian Core, look up the member, open Funds Transfer, move the given amount from the source share to the destination share with the given memo, review the confirmation screen, post the transfer, and read the resulting confirmation reference.\"",
  "id": "member.transfer-funds",
  "inputs": [
    {
      "description": "The credit union member number.",
      "name": "memberId",
      "pattern": "^\\d{6}$",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "Share id to debit. Must be a share whose status is OPEN.",
      "name": "fromShare",
      "pattern": "^\\d{6}-[A-Z0-9]+(-\\d+)?$",
      "required": true,
      "sensitivity": "internal",
      "type": "string"
    },
    {
      "description": "Share id to credit. Must differ from the source share.",
      "name": "toShare",
      "pattern": "^\\d{6}-[A-Z0-9]+(-\\d+)?$",
      "required": true,
      "sensitivity": "internal",
      "type": "string"
    },
    {
      "description": "Dollar amount to move. Kept at 1 for demo runs against a shared sandbox.",
      "name": "amount",
      "required": true,
      "sensitivity": "internal",
      "type": "money"
    },
    {
      "description": "Free-text memo recorded against the transfer.",
      "name": "memo",
      "pattern": "^.{0,40}$",
      "required": true,
      "sensitivity": "internal",
      "type": "string"
    }
  ],
  "interrupts": [
    {
      "name": "application-error-page",
      "notDuringAuth": false,
      "then": {
        "code": "APP_ERROR",
        "do": "fail",
        "message": "the application returned an error page with a support reference"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "APPLICATION ERROR|Reference: ERR-"
      }
    },
    {
      "name": "supervisor-override-required",
      "notDuringAuth": false,
      "then": {
        "code": "PERMISSION_DENIED",
        "do": "outcome"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "SUPERVISOR OVERRIDE REQUIRED|not authorized to perform this function"
      }
    },
    {
      "name": "session-timed-out",
      "notDuringAuth": true,
      "then": {
        "do": "reauthenticate",
        "maxAttempts": 1
      },
      "when": {
        "kind": "textPresent",
        "pattern": "YOUR SESSION HAS TIMED OUT|session ended due to inactivity"
      }
    },
    {
      "name": "maintenance-window",
      "notDuringAuth": false,
      "then": {
        "do": "dismiss",
        "target": {
          "description": "Continue link on the maintenance notice",
          "strategies": [
            {
              "kind": "role-name",
              "name": "Continue",
              "nameMatch": "normalized",
              "role": "link"
            }
          ]
        },
        "thenRetryStep": true
      },
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "textPresent",
            "pattern": "SCHEDULED MAINTENANCE IN PROGRESS|This window normally clears within a few moments"
          },
          {
            "kind": "controlPresent",
            "target": {
              "description": "Continue link on the maintenance notice",
              "strategies": [
                {
                  "kind": "role-name",
                  "name": "Continue",
                  "nameMatch": "normalized",
                  "role": "link"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "record-not-found",
      "notDuringAuth": true,
      "then": {
        "code": "MEMBER_NOT_FOUND",
        "do": "outcome"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "RECORD NOT FOUND|could not be located on this host"
      }
    },
    {
      "name": "unexpected-signon-screen",
      "notDuringAuth": true,
      "then": {
        "do": "escalate",
        "reason": "the application returned to the sign-on screen without reporting a timed-out session"
      },
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "textPresent",
            "pattern": "OPERATOR SIGN ON"
          },
          {
            "kind": "textAbsent",
            "pattern": "SESSION HAS TIMED OUT"
          }
        ]
      }
    }
  ],
