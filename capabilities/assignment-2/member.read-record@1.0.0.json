{
  "description": "Signs on, looks up the member by member number, and retrieves the member's name, e-mail address, and the balance and status of the specified share from the member record.\n\nRecorded from the goal: \"Sign on to Meridian Core, look up the member by member number, open their member record, and read the member's name and e-mail address from the record, plus the balance and the status of the one share whose Share ID matches the given share id, from the SHARES / BALANCES table. Find that row by its Share ID rather than by its position, because the table gains and loses rows between runs. The status cell shows the status code followed by a coloured badge that repeats it, for example \"OPEN\" rendered as \"OPEN [OPEN]\". Return only the leading code, not the badge.\"",
  "id": "member.read-record",
  "inputs": [
    {
      "description": "The credit union member number.",
      "name": "memberId",
      "pattern": "^\\d{6}$",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "The share id to read from the member's shares table.",
      "name": "shareId",
      "pattern": "^\\d{6}-[A-Z0-9]+(-\\d+)?$",
      "required": true,
      "sensitivity": "internal",
      "type": "string"
    }
  ],
  "interrupts": [
    {
      "name": "application-error-page",
      "notDuringAuth": false,
      "then": {
        "code": "APP_ERROR",
        "do": "fail",
        "message": "the application returned an error page with a support reference"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "APPLICATION ERROR|Reference: ERR-"
      }
    },
    {
      "name": "supervisor-override-required",
      "notDuringAuth": false,
      "then": {
        "code": "PERMISSION_DENIED",
        "do": "outcome"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "SUPERVISOR OVERRIDE REQUIRED|not authorized to perform this function"
      }
    },
    {
      "name": "session-timed-out",
      "notDuringAuth": true,
      "then": {
        "do": "reauthenticate",
        "maxAttempts": 1
      },
      "when": {
        "kind": "textPresent",
        "pattern": "YOUR SESSION HAS TIMED OUT|session ended due to inactivity"
      }
    },
    {
      "name": "maintenance-window",
      "notDuringAuth": false,
      "then": {
        "do": "dismiss",
        "target": {
          "description": "Continue link on the maintenance notice",
          "strategies": [
            {
              "kind": "role-name",
              "name": "Continue",
              "nameMatch": "normalized",
              "role": "link"
            }
          ]
        },
        "thenRetryStep": true
      },
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "textPresent",
            "pattern": "SCHEDULED MAINTENANCE IN PROGRESS|This window normally clears within a few moments"
          },
          {
            "kind": "controlPresent",
            "target": {
              "description": "Continue link on the maintenance notice",
              "strategies": [
                {
                  "kind": "role-name",
                  "name": "Continue",
                  "nameMatch": "normalized",
                  "role": "link"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "record-not-found",
      "notDuringAuth": true,
      "then": {
        "code": "MEMBER_NOT_FOUND",
        "do": "outcome"
      },
      "when": {
        "kind": "textPresent",
        "pattern": "RECORD NOT FOUND|could not be located on this host"
      }
    },
    {
      "name": "unexpected-signon-screen",
      "notDuringAuth": true,
      "then": {
        "do": "escalate",
        "reason": "the application returned to the sign-on screen without reporting a timed-out session"
      },
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "textPresent",
            "pattern": "OPERATOR SIGN ON"
          },
          {
            "kind": "textAbsent",
            "pattern": "SESSION HAS TIMED OUT"
          }
        ]
      }
    }
  ],
  "lifecycle": {
    "stability": {
      "consecutiveFailures": 0,
      "fallbackHits": 0,
      "runs": 0,
      "successes": 0
    },
    "state": "draft"
  },
  "name": "Read Record",
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "The member number was searched or navigated to and the host reported no such record. A legitimate answer, not an error.",
      "retryable": true
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The signed-on operator profile is not entitled to this function -- the host asks for a supervisor override. Placing a hold is the known case: a teller profile is refused at the review step, a supervisor profile is not. Requires a different operator identity, not a retry.",
      "retryable": false
    },
    {
      "code": "VALIDATION_REJECTED",
      "description": "The host rejected the submitted values as malformed. The caller should correct the inputs and retry.",
      "retryable": true
    },
    {
      "code": "SOURCE_SHARE_RESTRICTED",
      "description": "The source share carries a HOLD and cannot be debited. The automation did everything correctly and the bank declined; retrying the same inputs will always fail, but the same transfer from a different share may succeed.",
      "retryable": false
    },
    {
      "code": "INSUFFICIENT_FUNDS",
      "description": "The source share does not have the available balance for this amount. Not retryable with the same amount.",
      "retryable": false
    }
  ],
  "outputs": [
    {
      "description": "Read the member's name from the member record.",
      "name": "memberName",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "Read the member's e-mail address from the member record.",
      "name": "email",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    },
    {
      "description": "Read the balance for share ID {{input.shareId}} from the SHARES / BALANCES table.",
      "name": "shareBalance",
      "required": true,
      "sensitivity": "pii",
      "type": "money"
    },
    {
      "description": "Read the status code for share ID {{input.shareId}} from the SHARES / BALANCES table, capturing only the leading code before the badge.",
      "name": "shareStatus",
      "required": true,
      "sensitivity": "pii",
      "type": "string"
    }
  ],
